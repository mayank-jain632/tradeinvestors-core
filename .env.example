# Shared secret — must match SOLO_TRADER_SECRET configured in the relay
SOLO_TRADER_SECRET=replace_with_long_random_string

# Ops API key for internal monitoring endpoints
OPS_API_KEY=replace_with_long_random_string

# IB Gateway connection
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
IB_ACCOUNT=DU0000000

# Set to true to skip IB Gateway connection entirely (for testing)
DRY_RUN=false

# Risk
DEDUP_WINDOW_SECONDS=300

# Data paths (set by provisioning, normally don't change)
OPS_DB_PATH=/opt/solo-trader/data/ops.db
LEDGER_PATH=/opt/solo-trader/data/expected_positions.json
